/// A user's GitHub sign-in. The access token is AES-256-GCM ciphertext with
/// the `github` purpose label, so it cannot be replayed as an SSO secret, an AI
/// key, or a ChatGPT token. One connection per person, like ChatGPT.
model GithubConnection {
  id          String   @id
  userId      String   @unique
  login       String
  name        String?
  avatarUrl   String?
  scopes      Json     @default("[]")
  tokenType   String   @default("bearer")
  accessToken String
  lastError   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@map("github_connection")
}

/// One in-flight authorization attempt. `oauth` carries the callback state and
/// is completed by the server route; `device` carries GitHub's device code and
/// is completed by polling. Single use and short lived either way, and the
/// browser only ever sees our own id.
model GithubLoginState {
  id              String   @id
  userId          String
  mode            String   @default("oauth")
  deviceCode      String?  @unique
  userCode        String?
  intervalSeconds Int      @default(5)
  returnTo        String   @default("/app?view=settings&tab=sync")
  expiresAt       DateTime @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  @@index([expiresAt])
  @@index([userId])
  @@map("github_login_state")
}
