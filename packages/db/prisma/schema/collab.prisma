model Comment {
  id          String   @id
  workspaceId String
  pageId      String
  blockId     String?
  parentId    String?
  authorId    String
  body        String   @db.Text
  resolvedAt  DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)

  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentThread")

  @@index([pageId, createdAt])
  @@index([workspaceId, updatedAt])
  @@map("comment")
}

/// A proposed replacement body for a page, reviewed explicitly rather than
/// written straight into the document.
model SuggestedEdit {
  id           String    @id
  workspaceId  String
  pageId       String
  authorId     String
  baseRev      Int       @default(0)
  title        String
  content      Json
  note         String?
  status       String    @default("PENDING")
  reviewedById String?
  reviewedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(3)
  deletedAt    DateTime? @db.Timestamptz(3)

  @@index([workspaceId, status, updatedAt])
  @@index([pageId, status])
  @@map("suggested_edit")
}

/// A proposed replacement body for a page, reviewed explicitly rather than
/// written straight into the document.
model ShareLink {
  id           String    @id
  workspaceId  String
  resourceType String
  resourceId   String
  tokenHash    String    @unique
  permission   String    @default("VIEW")
  expiresAt    DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdById  String
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, resourceType, resourceId])
  @@map("share_link")
}

model ResourcePermission {
  id           String   @id
  workspaceId  String
  resourceType String
  resourceId   String
  userId       String
  role         String   @default("VIEWER")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@unique([resourceType, resourceId, userId])
  @@index([workspaceId, userId])
  @@map("resource_permission")
}

model AuditLog {
  id           String   @id
  workspaceId  String
  actorId      String?
  action       String
  resourceType String
  resourceId   String?
  metadata     Json     @default("{}")
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  @@index([workspaceId, createdAt])
  @@index([actorId])
  @@map("audit_log")
}

model Notification {
  id          String   @id
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String?
  href        String?
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([userId, readAt, createdAt])
  @@map("notification")
}

model Device {
  id         String   @id
  userId     String
  name       String
  platform   String
  lastSeenAt DateTime @default(now()) @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)

  @@unique([userId, id])
  @@index([userId])
  @@map("device")
}

/// A named automation destination. A workspace can run several, each with its
/// own event subscription and condition filters applied when an event is queued.
model WebhookEndpoint {
  id             String    @id
  workspaceId    String
  name           String    @default("Webhook")
  url            String
  secret         String
  events         Json      @default("[]")
  filters        Json      @default("{}")
  enabled        Boolean   @default(true)
  createdById    String
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)
  lastDeliveryAt DateTime? @db.Timestamptz(3)
  lastStatus     Int?

  @@index([workspaceId, updatedAt])
  @@map("webhook_endpoint")
}

/// Queued webhook delivery, written inside the same transaction as the change
/// log so an event cannot be lost if the process restarts.
model WebhookDelivery {
  id            String    @id
  workspaceId   String
  endpointId    String
  event         String
  payload       Json
  status        String    @default("PENDING")
  attempts      Int       @default(0)
  lastError     String?
  nextAttemptAt DateTime  @default(now()) @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  deliveredAt   DateTime? @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
  @@map("webhook_delivery")
}

/// Persisted Yjs document for a collaborative resource, so a live session
/// survives its room and a peer that disconnects mid-edit does not take the
/// edit with it.
model CollabDocument {
  resourceType String
  resourceId   String
  workspaceId  String
  state        Bytes    @db.ByteA
  /// Size of the persisted update, for observability rather than logic.
  size         Int      @default(0)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  @@id([resourceType, resourceId])
  @@index([workspaceId])
  @@map("collab_document")
}
