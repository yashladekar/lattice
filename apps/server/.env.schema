# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @optional @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @public @optional @type=url
POLAR_SUCCESS_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Optional OpenAI-compatible provider. Without a key, AI features fall back to
# local retrieval and are labeled "Local mode".
# @optional @type=url
AI_BASE_URL=

# @optional @type=string(minLength=1)
AI_API_KEY=

# Model identifiers, not secrets. They are shown in Settings and written into
# capture metadata on purpose, so they must not trip the runtime leak scanner.
# @optional @sensitive=false @type=string(minLength=1)
AI_MODEL=

# Embeddings model used by the optional semantic index.
# @optional @sensitive=false @type=string(minLength=1)
AI_EMBEDDING_MODEL=

# Audio transcription model, e.g. whisper-1.
# @optional @sensitive=false @type=string(minLength=1)
AI_TRANSCRIBE_MODEL=

# Experimental. Lets Ask read pages and propose page edits, graph links, and
# flashcards. Off by default; the UI stays hidden while false.
# @optional @sensitive=false @type=boolean
AI_AGENT_ENABLED=false

# Where uploaded files are written. Mount a volume here when self-hosting.
# @optional @type=string(minLength=1)
UPLOAD_DIR=

# Experimental. Connect GitHub with the device flow so imports and sync use a
# stored credential instead of a pasted token. Off by default; without it the
# dialog keeps its manual token field.
# @optional @sensitive=false @type=boolean
GITHUB_CONNECT_ENABLED=false

# OAuth App client id for the GitHub device flow. Not a secret. The app must
# have device flow enabled in its GitHub settings.
# @optional @sensitive=false @type=string(minLength=1)
GITHUB_CLIENT_ID=
