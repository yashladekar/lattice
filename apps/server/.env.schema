# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @optional @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @public @optional @type=url
POLAR_SUCCESS_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Optional OpenAI-compatible provider. Without a key, AI features fall back to
# local retrieval and are labeled "Local mode".
# @optional @type=url
AI_BASE_URL=

# @optional @type=string(minLength=1)
AI_API_KEY=

# @optional @type=string(minLength=1)
AI_MODEL=

# Embeddings model used by the optional semantic index.
# @optional @type=string(minLength=1)
AI_EMBEDDING_MODEL=

# Audio transcription model, e.g. whisper-1.
# @optional @type=string(minLength=1)
AI_TRANSCRIBE_MODEL=

# Where uploaded files are written. Mount a volume here when self-hosting.
# @optional @type=string(minLength=1)
UPLOAD_DIR=
