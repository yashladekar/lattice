# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @type=url
BETTER_AUTH_URL=

# @optional @type=string(minLength=1)
POLAR_ACCESS_TOKEN=

# @public @optional @type=url
POLAR_SUCCESS_URL=

# @public @type=url
CORS_ORIGIN=

# @type=string(minLength=1)
DATABASE_URL=

# Direct (non-pooled) connection used by migrations. Optional: without it,
# migrations use DATABASE_URL.
# @optional @type=string(minLength=1)
DIRECT_URL=

# Maximum connections this process may open. Serverless deployments should use
# 1 together with a pooled DATABASE_URL.
# @optional @sensitive=false @type=string(minLength=1)
DATABASE_POOL_MAX=

# Optional OpenAI-compatible provider. Without a key, AI features fall back to
# local retrieval and are labeled "Local mode".
# @optional @type=url
AI_BASE_URL=

# @optional @type=string(minLength=1)
AI_API_KEY=

# Model identifiers, not secrets. They are shown in Settings and written into
# capture metadata on purpose, so they must not trip the runtime leak scanner.
# @optional @sensitive=false @type=string(minLength=1)
AI_MODEL=

# Embeddings model used by the optional semantic index.
# @optional @sensitive=false @type=string(minLength=1)
AI_EMBEDDING_MODEL=

# Audio transcription model, e.g. whisper-1.
# @optional @sensitive=false @type=string(minLength=1)
AI_TRANSCRIBE_MODEL=

# Experimental. Lets Ask read pages and propose page edits, graph links, and
# flashcards. Off by default; the UI stays hidden while false.
# @optional @sensitive=false @type=boolean
AI_AGENT_ENABLED=false

# Where uploaded files are written. Mount a volume here when self-hosting.
# @optional @type=string(minLength=1)
UPLOAD_DIR=

# "local" writes to UPLOAD_DIR. "s3" uses an S3-compatible bucket and requires
# the S3_* variables below; serverless deployments must use "s3".
# @optional @sensitive=false @type=enum(local,s3)
UPLOAD_DRIVER=

# Largest accepted upload, in bytes.
# @optional @sensitive=false @type=string(minLength=1)
UPLOAD_MAX_BYTES=

# S3-compatible storage (Cloudflare R2, AWS S3, MinIO). Custom endpoint and
# path-style addressing are for R2/MinIO; leave S3_ENDPOINT unset for AWS.
# @optional @sensitive=false @type=url
S3_ENDPOINT=

# @optional @sensitive=false @type=string(minLength=1)
S3_REGION=

# @optional @sensitive=false @type=string(minLength=1)
S3_BUCKET=

# @optional @type=string(minLength=1)
S3_ACCESS_KEY_ID=

# @optional @type=string(minLength=1)
S3_SECRET_ACCESS_KEY=

# Public base URL used to build absolute media links, e.g. an R2 custom domain.
# @optional @sensitive=false @type=url
S3_PUBLIC_URL=

# @optional @sensitive=false @type=boolean
S3_FORCE_PATH_STYLE=

# Bearer secret for the /cron endpoint. Unset keeps the endpoint closed.
# @optional @type=string(minLength=16)
CRON_SECRET=

# Experimental. Connect GitHub with the device flow so imports and sync use a
# stored credential instead of a pasted token. Off by default; without it the
# dialog keeps its manual token field.
# @optional @sensitive=false @type=boolean
GITHUB_CONNECT_ENABLED=false

# OAuth App client id. Not a secret.
# @optional @sensitive=false @type=string(minLength=1)
GITHUB_CLIENT_ID=

# OAuth App client secret. With it, Connect uses the authorization-code flow
# and a callback; without it, the device flow is offered instead.
# @optional @type=string(minLength=1)
GITHUB_CLIENT_SECRET=

# Public callback URL registered on the OAuth App. Defaults to
# ${BETTER_AUTH_URL}/api/github/callback.
# @optional @sensitive=false @type=url
GITHUB_REDIRECT_URI=
