{
  "manifest_version": 3,
  "name": "Lattice Clip",
  "version": "0.1.0",
  "description": "Send the current page to your Lattice knowledge inbox.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "action": {
    "default_title": "Clip to Lattice",
    "default_popup": "popup.html",
    "default_icon": {
      "96": "icons/icon-96.png",
      "192": "icons/icon-192.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "96": "icons/icon-96.png",
    "192": "icons/icon-192.png"
  }
}
